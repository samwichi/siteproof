{{!-- The edit form replaces the whole table row. A <form> cannot be placed between <tr> and <td>, so the form is inside one wide cell. --}}
<tr class="table-warning">
  <td colspan="7">
    <form class="row g-2 align-items-end" hx-put="/documents/{{ID}}" hx-encoding="multipart/form-data" hx-target="closest tr" hx-swap="outerHTML" hx-disable="findAll button">
      <div class="col-12">
        <strong>Document #{{ID}}</strong> - delivery #{{deliveryId}} ({{material}}, {{project}})
      </div>
      <div class="col-md-4">
        <label class="form-label" for="doctype-{{ID}}">Document type</label>
        <select class="form-select" id="doctype-{{ID}}" autofocus name="doc_type" required>
          {{#each typeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="file-{{ID}}">New file (optional)</label>
        <input class="form-control" id="file-{{ID}}" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="file-help-{{ID}}">
        <div id="file-help-{{ID}}" class="form-text">Now: {{#if hasFile}}<a class="link-dark" href="/files/document/{{ID}}" target="_blank" rel="noopener" hx-boost="false">{{fileName}}</a> <span class="text-muted small">({{fileType}}, {{kb}} KB)</span>{{else}}{{fileName}} <span class="text-muted small">(no file)</span>{{/if}}. Choose a file only to replace it.</div>
      </div>
      <div class="col-md-2 text-nowrap">
        {{!-- Both buttons have the name "action": the route reads req.body.action to know which one was clicked. --}}
        <button type="submit" class="btn btn-success" title="Update" aria-label="Update document #{{ID}}" name="action" value="update">
          <i aria-hidden="true" class="bi bi-check-lg"></i>
        </button>
        <button type="submit" class="btn btn-warning" title="Cancel" aria-label="Cancel" name="action" value="cancel" formnovalidate>
          <i aria-hidden="true" class="bi bi-x-lg"></i>
        </button>
      </div>
    </form>
  </td>
</tr>
