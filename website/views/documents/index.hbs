<h1 class="h2">Quality documents</h1>
<p class="text-muted">Documents of your deliveries, with the file (PDF, JPG or PNG). You can add a document at any time (for example the 28-day test report after the inspection); you can change or delete it only until the delivery is inspected. The contractor and the inspector can open the files.</p>
<p>
  <a class="btn btn-success" href="/documents/new" hx-boost="true" hx-target="#main">
    <i aria-hidden="true" class="bi bi-plus-circle-fill"></i> New document
  </a>
</p>
{{> list/controls placeholder="Search by ID, delivery, material, document type or file name"}}
<div id="list" data-count="{{list.total}}">
  <div class="table-responsive">
    <table class="table table-striped table-hover table-sm">
      <caption class="visually-hidden">Quality documents</caption>
      <thead>
        <tr>
          {{> list/th key="ID" label="ID"}}
          {{> list/th key="delivery" label="Delivery"}}
          {{> list/th key="material" label="Material"}}
          {{> list/th key="docType" label="Document type"}}
          {{> list/th key="fileName" label="File name"}}
          {{> list/th key="uploadedBy" label="Uploaded by"}}
          {{> list/th key="status" label="Delivery status"}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          {{> documents/row}}
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#unless rows.length}}
    <p class="text-muted text-center">{{#if list.filtered}}No document matches your search.{{else}}No documents yet.{{/if}}</p>
  {{/unless}}
  {{> list/pager}}
</div>
{{#if message}}{{> toast}}{{/if}}
