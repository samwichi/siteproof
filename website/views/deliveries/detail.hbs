{{!-- UC3: everything about one delivery in one page (read only). --}}
<p>
  <a class="btn btn-outline-secondary btn-sm" href="/deliveries" hx-boost="true" hx-target="#main">
    <i aria-hidden="true" class="bi bi-arrow-left"></i> Back to my deliveries
  </a>
</p>

<h1 class="h2">Delivery #{{ID}} <span class="badge text-bg-{{badge}} fs-6 align-middle">{{status}}</span>
  <a class="btn btn-outline-primary btn-sm align-middle ms-2" href="/messages/delivery/{{ID}}" hx-boost="true" hx-target="#main">
    <i aria-hidden="true" class="bi bi-chat-dots"></i> Messages with the supplier
  </a>
</h1>

{{#if isDeclined}}
  <div class="alert alert-danger"><i aria-hidden="true" class="bi bi-x-circle"></i> <strong>{{supplier}} declined this delivery:</strong> {{declineReason}}
    <br>Change the quantity, the price or the time slot in "My deliveries" (the supplier is asked again), or delete the delivery.</div>
{{/if}}
<div class="d-flex flex-wrap gap-1 align-items-center my-3 small">
  {{#each steps}}
    <span class="d-inline-flex flex-column align-items-center">
      <span class="badge {{#if current}}text-bg-primary{{else}}{{#if done}}text-bg-success{{else}}text-bg-light border text-muted{{/if}}{{/if}}">{{name}}</span>
      <span class="text-muted" style="font-size: 0.75em;">{{#if time}}{{time}}{{else}}&nbsp;{{/if}}</span>
    </span>
    <i aria-hidden="true" class="bi bi-chevron-right text-muted"></i>
  {{/each}}
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i aria-hidden="true" class="bi bi-box-seam"></i> Order</div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item"><strong>Project:</strong> {{project}}</li>
        <li class="list-group-item"><strong>Supplier:</strong> {{supplier}}</li>
        <li class="list-group-item"><strong>Material:</strong> {{material}}</li>
        <li class="list-group-item"><strong>Quantity:</strong> {{quantity}} {{unit}}</li>
        <li class="list-group-item"><strong>Value:</strong> NT$ {{value}}</li>
        <li class="list-group-item"><strong>Time slot:</strong> {{slotStart}} - {{slotEnd}}{{#if arrival}} <span class="badge text-bg-{{arrival.kind}}">{{arrival.text}}</span>{{/if}}</li>
        {{#if source}}<li class="list-group-item"><strong>From:</strong> <a href="/rfqs/{{source.rfqId}}" hx-boost="true" hx-target="#main">RFQ #{{source.rfqId}} {{source.rfqTitle}}</a> (accepted quotation)</li>{{/if}}
      </ul>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i aria-hidden="true" class="bi bi-clipboard-check"></i> Inspection and retention</div>
      {{#if inspection}}
        <ul class="list-group list-group-flush">
          <li class="list-group-item"><strong>Decision:</strong> {{inspection.decision}} (by {{inspection.inspector}})</li>
          <li class="list-group-item"><strong>Quantity:</strong> received {{inspection.received}} {{unit}}, accepted {{inspection.accepted}} {{unit}}</li>
          <li class="list-group-item"><strong>Accepted value:</strong> NT$ {{inspection.acceptedValue}}</li>
          <li class="list-group-item"><strong>Retention:</strong> NT$ {{inspection.retention}} ({{inspection.retentionPercent}}% of the accepted value)</li>
        </ul>
      {{else}}
        <div class="card-body text-muted">Not inspected yet. The inspector records the quantity after the delivery arrives.</div>
      {{/if}}
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i aria-hidden="true" class="bi bi-file-earmark-text"></i> Quality documents</div>
      {{#if documents.length}}
        <ul class="list-group list-group-flush">
          {{#each documents}}
            <li class="list-group-item"><i aria-hidden="true" class="bi bi-file-earmark-text"></i> {{doc_type}}: {{#if hasFile}}<a href="/files/document/{{ID}}" target="_blank" rel="noopener" hx-boost="false">{{file_name}}</a>{{else}}{{file_name}} <span class="text-muted small">(no file)</span>{{/if}}</li>
          {{/each}}
        </ul>
      {{else}}
        <div class="card-body text-muted">The supplier has not added any document yet.</div>
      {{/if}}
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><i aria-hidden="true" class="bi bi-star"></i> Supplier rating</div>
      <div class="card-body">
        {{#if rating}}
          <span class="stars fs-4" role="img" aria-label="{{rating.score}} out of 5">{{rating.stars}}</span> ({{rating.score}} of 5)<br>
          <small class="text-muted">rated by {{rating.ratedBy}}</small>
        {{else}}
          <span class="text-muted">Not rated yet.</span>
          {{#if canRate}}
            <a class="btn btn-success btn-sm ms-2" href="/ratings" hx-boost="true" hx-target="#main">
              <i aria-hidden="true" class="bi bi-star-fill"></i> Complete and rate
            </a>
          {{else}}
            <span class="text-muted">The rating is given after the inspection.</span>
          {{/if}}
        {{/if}}
      </div>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header"><i aria-hidden="true" class="bi bi-clock-history"></i> History</div>
  {{#if history.length}}
    <ul class="list-group list-group-flush">
      {{#each history}}
        <li class="list-group-item d-flex flex-wrap gap-2">
          <span class="text-muted text-nowrap">{{time}}</span>
          <strong>{{label}}</strong>
          <span>by {{person}}{{#if company}} ({{company}}){{/if}}</span>
          {{#if note}}<span class="text-muted">· {{note}}</span>{{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <div class="card-body text-muted">No times were recorded for this delivery (it is older than the history).</div>
  {{/if}}
</div>
