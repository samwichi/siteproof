<h2>My deliveries</h2>
<p>
  <a class="btn btn-success" href="/deliveries/new" hx-boost="true" hx-target="#main">
    <i class="bi bi-plus-circle-fill"></i> New delivery
  </a>
</p>
<table class="table table-striped table-hover table-sm">
  <thead>
    <tr>
      <th>ID</th><th>Project</th><th>Supplier</th><th>Material</th>
      <th class="text-end">Quantity</th><th class="text-end">Value (NT$)</th><th>Time slot</th><th>Status</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      {{> deliveries/row}}
    {{/each}}
  </tbody>
</table>
{{#unless rows.length}}
  <p class="text-muted text-center">No deliveries yet.</p>
{{/unless}}
{{#if message}}{{> toast}}{{/if}}
