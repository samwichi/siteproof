<h1 class="h2">All users</h1>
<p class="text-muted">Everybody who has an account, and the company of each one.</p>
{{> list/controls placeholder="Search by name, e-mail or company"}}
<div id="list" data-count="{{list.total}}">
  <div class="table-responsive">
    <table class="table table-striped table-hover table-sm">
      <caption class="visually-hidden">All users</caption>
      <thead>
        <tr>
          {{> list/th key="name" label="Name"}}
          {{> list/th key="email" label="E-mail"}}
          {{> list/th key="role" label="Role"}}
          {{> list/th key="company" label="Company"}}
          {{> list/th key="status" label="Status"}}
          {{> list/th key="registered" label="Registered"}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr class="align-middle">
          <td>{{name}}</td>
          <td>{{email}}</td>
          <td>{{roleName}}</td>
          <td>{{#if orgId}}<a class="d-inline-block py-1" href="/admin/companies/{{orgId}}" hx-boost="true" hx-target="#main">{{company}}</a>{{else}}-{{/if}}</td>
          <td>{{#if isWaiting}}<span class="badge text-bg-warning">Waiting for the company</span>{{else}}{{#if isRejected}}<span class="badge text-bg-danger">Rejected by the company</span>{{else}}{{#if isActive}}<span class="badge text-bg-success">Active</span>{{else}}<span class="badge text-bg-secondary">Switched off</span>{{/if}}{{/if}}{{/if}}</td>
          <td class="text-nowrap">{{registered}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#unless rows.length}}
    <p class="text-muted text-center">No user matches your search.</p>
  {{/unless}}
  {{> list/pager}}
</div>
