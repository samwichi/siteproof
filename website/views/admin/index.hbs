<h1 class="h2">Companies</h1>
{{#if pending}}
  <div class="alert alert-warning py-2"><i aria-hidden="true" class="bi bi-hourglass-split"></i> {{pending}} {{#if pendingMany}}companies are{{else}}company is{{/if}} waiting for your approval (shown first).
    <a class="alert-link" href="/admin?status=PENDING" hx-boost="true" hx-target="#main">Show only these</a></div>
{{else}}
  <p class="text-muted">No company is waiting for approval. Click the ID of a company to see its documents and users.</p>
{{/if}}
{{> list/controls placeholder="Search by ID, name, e-mail, phone or address"}}
<div id="list" data-count="{{list.total}}">
  {{#if hidden}}
    <p class="text-muted small mb-2"><i aria-hidden="true" class="bi bi-info-circle"></i> {{hidden}} companies without an account are not shown (for example the companies of the given data). Choose "All companies" to see them.</p>
  {{/if}}
  <div class="table-responsive">
    <table class="table table-striped table-hover table-sm">
      <caption class="visually-hidden">Companies</caption>
      <thead>
        <tr>
          {{> list/th key="ID" label="ID"}}
          {{> list/th key="name" label="Company"}}
          {{> list/th key="type" label="Type"}}
          <th scope="col">Phone and e-mail</th>
          <th scope="col">Address</th>
          {{> list/th key="status" label="Status"}}
          {{> list/th key="users" label="Users" cls="text-end"}}
          <th scope="col" class="text-end">Documents</th>
          {{> list/th key="registered" label="Registered"}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr class="align-middle">
          <td class="text-nowrap"><a class="d-inline-block px-2 py-1" href="/admin/companies/{{ID}}" hx-boost="true" hx-target="#main" title="Open the page of {{name}}">{{ID}}</a></td>
          <td>{{name}}
            {{#if sameName}}<br><a class="badge text-bg-warning text-decoration-none" href="/admin?scope=all&amp;q={{encodedName}}" hx-boost="true" hx-target="#main" title="Show the companies called {{name}}">{{sameName}} more with this name</a>{{/if}}</td>
          <td>{{typeName}}</td>
          <td class="small">{{#if phone}}{{phone}}{{/if}}{{#if email}}<br>{{email}}{{/if}}{{#unless phone}}{{#unless email}}-{{/unless}}{{/unless}}</td>
          <td class="small">{{#if address}}{{address}}{{else}}-{{/if}}</td>
          <td><span class="badge text-bg-{{badge}}">{{status}}</span></td>
          <td class="text-end">{{users}}</td>
          <td class="text-end">{{documents}}</td>
          <td class="text-nowrap">{{registered}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#unless rows.length}}
    <p class="text-muted text-center">No company matches your search.</p>
  {{/unless}}
  {{> list/pager}}
</div>
