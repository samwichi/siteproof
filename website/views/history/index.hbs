<h2>My rating and history</h2>
<p class="text-muted">How the contractors rated your company, and the history of your deliveries.</p>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card h-100 text-center">
      <div class="card-body">
        <div class="text-muted">Average rating</div>
        {{#if summary.rated}}
          <div class="display-5">{{summary.average}} <small class="fs-5 text-muted">/ 5</small></div>
          <div class="text-warning fs-5">{{summary.averageStars}}</div>
         <small class="text-muted">Number of ratings: {{summary.rated}}</small>
        {{else}}
          <div class="display-5 text-muted">-</div>
          <small class="text-muted">No delivery has been rated yet.</small>
        {{/if}}
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 text-center">
      <div class="card-body">
        <div class="text-muted">Deliveries</div>
        <div class="display-5">{{summary.deliveries}}</div>
        <small class="text-muted">{{summary.completed}} completed</small>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted text-center mb-2">Scores</div>
        {{#each distribution}}
          <div class="d-flex align-items-center small mb-1">
            <span class="text-nowrap me-2" style="width: 3.5em;">{{score}} <i class="bi bi-star-fill text-warning"></i></span>
            <div class="progress flex-grow-1" style="height: 0.8em;">
              <div class="progress-bar bg-warning" role="progressbar" style="width: {{percent}}%"></div>
            </div>
            <span class="ms-2 text-end" style="width: 2em;">{{n}}</span>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>

<h3 class="h5">Delivery history</h3>
<table class="table table-striped table-hover table-sm">
  <thead>
    <tr>
      <th>ID</th><th>Date</th><th>Contractor / project</th><th>Material</th>
      <th class="text-end">Quantity</th><th>Inspection</th><th>Rating</th><th>Status</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      <tr class="align-middle">
        <td>{{ID}}</td>
        <td class="text-nowrap">{{date}}</td>
        <td>{{contractor}}<br><small class="text-muted">{{project}}</small></td>
        <td class="text-truncate" style="max-width: 240px;" title="{{material}}">{{material}}</td>
        <td class="text-end text-nowrap">{{quantity}} {{unit}}</td>
        <td>
          {{#if decision}}
            {{decision}}<br><small class="text-muted">received {{received}}, accepted {{accepted}}</small>
          {{else}}
            <span class="text-muted">Not inspected yet</span>
          {{/if}}
        </td>
        <td class="text-nowrap">
          {{#if stars}}<span class="text-warning">{{stars}}</span>{{else}}<span class="text-muted">Not rated</span>{{/if}}
        </td>
        <td><span class="badge text-bg-{{badge}}">{{status}}</span></td>
      </tr>
    {{/each}}
  </tbody>
</table>
{{#unless rows.length}}
  <p class="text-muted text-center">No deliveries yet.</p>
{{/unless}}
{{#if limited}}
  <p class="text-muted small">Showing the latest {{maxRows}} deliveries. The summary above counts all of them.</p>
{{/if}}
