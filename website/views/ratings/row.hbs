<tr class="align-middle">
  <td class="text-nowrap">
    {{#if canRate}}
      <button type="button" class="btn btn-sm btn-success"
            hx-get="/ratings/{{ID}}/new" hx-target="closest tr" hx-swap="outerHTML" title="Complete and rate delivery #{{ID}}" aria-label="Complete and rate delivery #{{ID}}">
        <i aria-hidden="true" class="bi bi-star-fill"></i>
      </button>
    {{/if}}
    {{#if canChange}}
      <button type="button" class="btn btn-sm btn-danger"
            hx-delete="/ratings/{{ID}}" hx-target="closest tr" hx-swap="outerHTML"
            hx-confirm="Delete the rating of delivery #{{ID}}? The delivery will not be completed any more." title="Delete the rating of delivery #{{ID}}" aria-label="Delete the rating of delivery #{{ID}}">
        <i aria-hidden="true" class="bi bi-trash3-fill"></i>
      </button>
      <button type="button" class="btn btn-sm btn-primary"
            hx-get="/ratings/{{ID}}/edit" hx-target="closest tr" hx-swap="outerHTML" title="Change the rating of delivery #{{ID}}" aria-label="Change the rating of delivery #{{ID}}">
        <i aria-hidden="true" class="bi bi-pencil"></i>
      </button>
    {{/if}}
    {{ID}}
  </td>
  <td>{{project}}</td>
  <td>{{supplier}}</td>
  <td class="text-truncate" style="max-width: 220px;" title="{{material}}">{{material}}</td>
  <td>{{decision}}<br><small class="text-muted">received {{received}}, accepted {{accepted}}</small></td>
  <td class="text-nowrap">
    {{#if stars}}
      <span class="stars" role="img" aria-label="{{score}} out of 5">{{stars}}</span><br><small class="text-muted">by {{ratedBy}}</small>
    {{else}}
      <span class="text-muted">Not rated</span>
    {{/if}}
  </td>
  <td><span class="badge text-bg-{{badge}}">{{status}}</span></td>
</tr>
