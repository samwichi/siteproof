{{!-- My storefront: the listed products of the supplier as the contractors see them in the shop (routes/seller.js). --}}
<div hx-boost:inherited="true" hx-target:inherited="#main">
  <nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/seller">Seller center</a></li>
      <li class="breadcrumb-item active" aria-current="page">My storefront</li>
    </ol>
  </nav>

  <section class="shop-hero rounded-3 p-4 mb-4">
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <span class="shop-icon shop-icon-lg rounded-3"><i aria-hidden="true" class="bi bi-shop"></i></span>
      <div class="flex-grow-1">
        <h1 class="h3 mb-1">{{company}}</h1>
        <div>
          {{#if stats.average}}
            <span class="stars" role="img" aria-label="{{stats.average}} out of 5">{{stats.averageStars}}</span> {{stats.average}}
            <small class="text-muted">({{stats.rated}} rated)</small>
          {{else}}<span class="text-muted">No rating yet</span>{{/if}}
          {{#if stats.arrived}} · <span>{{stats.onTimePercent}}% on time</span>{{/if}}
          · <span>{{cardsText}}</span>
        </div>
      </div>
      <a class="btn btn-primary" href="/products"><i aria-hidden="true" class="bi bi-pencil-square"></i> Edit my products</a>
    </div>
  </section>

  <p class="text-muted">This is how the contractors see your products in their shop: the price range, the lead time and the minimum order.
     The place of your price shows how your lowest price compares with the other approved suppliers of the same material.
     {{#if unlisted}}Not shown: {{unlistedText}}.{{/if}}</p>
  {{#unless approved}}<div class="alert alert-warning">Your company is not approved yet, so the contractors do not see these products yet.</div>{{/unless}}

  {{#if cards.length}}
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
    {{#each cards}}
    <div class="col">
      <div class="card h-100 {{#if cheapest}}border-success border-2{{/if}}">
        <div class="card-body d-flex flex-column">
          <div class="d-flex align-items-start gap-2 mb-2">
            <span class="shop-icon rounded-2"><i aria-hidden="true" class="bi {{icon}}"></i></span>
            <h2 class="h6 mb-0 shop-name" title="{{name}}">{{name}}</h2>
          </div>
          <div class="small text-muted mb-2">{{category}} · per {{unit}}</div>
          <div class="fw-semibold">NT$ {{#if samePrice}}{{priceMin}}{{else}}{{priceMin}} - {{priceMax}}{{/if}} <span class="small text-muted fw-normal">/ {{unit}}</span></div>
          <ul class="list-unstyled small text-muted mb-2">
            <li>Lead time: {{#if leadText}}{{leadText}}{{else}}not given{{/if}}</li>
            <li>Minimum order: {{#if minOrder}}{{minOrder}} {{unit}}{{else}}none{{/if}}</li>
          </ul>
          <div class="mt-auto">
            <span class="badge {{#if cheapest}}text-bg-success{{else if alone}}text-bg-info{{else}}text-bg-light border{{/if}}">{{placeText}}</span>
          </div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <p class="text-muted">No product is listed. <a href="/products">Add your first product</a> so that contractors can find you.</p>
  {{/if}}
</div>
