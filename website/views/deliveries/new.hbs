<h1 class="h2">New delivery</h1>
{{#if productMissing}}
  <div class="alert alert-warning">This product is not in the catalog any more (the supplier unlisted or deleted it). Please choose the supplier and the material below.</div>
{{/if}}
{{#unless projects.length}}
  <div class="alert alert-warning">Your company has no project yet, so a delivery cannot be created. Please ask the company account of {{user.orgName}} to create the project (menu Projects).</div>
{{/unless}}
<form class="row g-3" hx-post="/deliveries" hx-target="#main" hx-push-url="/deliveries" hx-disable="findAll button">
  <div class="col-md-6">
    <label class="form-label" for="project_id">Project</label>
    <select class="form-select" id="project_id" name="project_id" required>
      <option value="" selected disabled>Choose a project</option>
      {{#each projects}}
        <option value="{{project_id}}">{{project_name}}</option>
      {{/each}}
    </select>
  </div>
  {{#if product}}
  {{!-- Opened from "Find products": the supplier and the material come from the catalog (hidden fields), the price range is shown as a help. --}}
  <div class="col-12">
    <div class="card border-success">
      <div class="card-body py-2">
        <div class="small text-muted">From the product catalog</div>
        <strong>{{product.material}}</strong> ({{product.unit}}) from <strong>{{product.supplier}}</strong>
        <div class="small">Price range {{product.priceMinText}}{{#unless product.samePrice}} - {{product.priceMaxText}}{{/unless}} NT$ / {{product.unit}}{{#if product.minOrder}} · minimum order {{product.minOrder}} {{product.unit}}{{/if}}{{#if product.leadTime}} · lead time {{product.leadTime}} days{{/if}}</div>
        {{#if product.note}}<div class="small text-muted">{{product.note}}</div>{{/if}}
        <a class="small" href="/deliveries/new" hx-boost="true" hx-target="#main">Choose another supplier or material</a>
      </div>
    </div>
    <input type="hidden" name="org_id" value="{{product.supplierId}}">
    <input type="hidden" name="material_id" value="{{product.materialId}}">
  </div>
  {{else}}
  <div class="col-md-6">
    <label class="form-label" for="supplier_search">Supplier</label>
    {{!-- Typing here asks the server for the matching suppliers and replaces the options of the <select> below. --}}
    <input class="form-control mb-1" type="search" id="supplier_search" name="q" placeholder="Type a part of the supplier name to search" autocomplete="off"
           hx-get="/deliveries/suppliers" hx-trigger="input delay:300ms" hx-target="#org_id" hx-swap="innerHTML" hx-sync="this:replace">
    <select class="form-select" id="org_id" name="org_id" required aria-label="Supplier (search results)">
      {{> deliveries/supplierOptions}}
    </select>
  </div>
  <div class="col-12">
    <label class="form-label" for="material_search">Material</label>
    {{!-- The category buttons and the search box ask the server for the matching materials and replace the options of the <select> below. --}}
    <div id="material_buttons" class="d-flex flex-wrap gap-1 mb-2" role="group" aria-label="Material category">
      {{> deliveries/materialButtons}}
    </div>
    <input class="form-control mb-1" type="search" id="material_search" name="material_q" placeholder="Type a part of the material name to search" autocomplete="off"
           hx-get="/deliveries/materials" hx-trigger="input delay:300ms" hx-include="#material_cat" hx-target="#material_id" hx-swap="innerHTML" hx-sync="this:replace">
    <select class="form-select" id="material_id" name="material_id" required aria-label="Material (search results)">
      {{> deliveries/materialOptions}}
    </select>
  </div>
  {{/if}}
  <div class="col-md-3">
    <label class="form-label" for="ordered_quantity">Ordered quantity</label>
    <input class="form-control" type="number" id="ordered_quantity" name="ordered_quantity" min="0.01" step="0.01" required{{#if product.minOrder}} value="{{product.minOrder}}"{{/if}}>
  </div>
  <div class="col-md-3">
    <label class="form-label" for="unit_price">Agreed unit price (NT$)</label>
    <input class="form-control" type="number" id="unit_price" name="unit_price" min="0" step="0.01" required{{#if product}} value="{{product.priceMid}}" aria-describedby="price-help"{{/if}}>
    {{#if product}}<div id="price-help" class="form-text">The middle of the catalog price range. Change it to the price that you agreed with the supplier.</div>{{/if}}
  </div>
  <div class="col-md-3">
    <label class="form-label" for="slot_start">Time slot start</label>
    <input class="form-control" type="datetime-local" id="slot_start" name="slot_start" required>
  </div>
  <div class="col-md-3">
    <label class="form-label" for="slot_end">Time slot end</label>
    <input class="form-control" type="datetime-local" id="slot_end" name="slot_end" required>
  </div>
  <div class="col-12">
    <button class="btn btn-success"><i aria-hidden="true" class="bi bi-check-circle-fill"></i> Create delivery</button>
    <a class="btn btn-secondary" href="/deliveries" hx-boost="true" hx-target="#main">Cancel</a>
  </div>
</form>
