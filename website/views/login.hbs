<div class="row justify-content-center">
  <div class="col-md-5">
    <h2 class="mb-3">Sign in</h2>
    {{#if error}}
      <div class="alert alert-danger">Wrong e-mail or password.</div>
    {{/if}}
    {{!-- A normal form: after the login the whole page is loaded again, so the navbar shows the user. --}}
    <form action="/login" method="post">
      <div class="mb-3">
        <label class="form-label" for="email">E-mail</label>
        <input class="form-control" type="email" id="email" name="email" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" type="password" id="password" name="password" required>
      </div>
      <button class="btn btn-primary"><i class="bi bi-box-arrow-in-right"></i> Sign in</button>
    </form>
  </div>
</div>
