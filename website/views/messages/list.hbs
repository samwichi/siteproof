{{!-- The messages of one conversation. The list asks for itself again every 10 seconds (new messages of the other side appear). --}}
<div id="messages" class="d-flex flex-column gap-2 mb-3" hx-get="{{url}}/list" hx-trigger="every 10s" hx-swap="outerHTML">
  {{#each messages}}
    <div class="card {{#if mine}}align-self-end border-primary bg-primary-subtle{{else}}align-self-start{{/if}}" style="max-width: 75%;">
      <div class="card-body py-2 px-3">
        <div class="small text-muted mb-1">
          <strong class="text-body">{{#if mine}}You{{else}}{{sender}}{{/if}}</strong> · {{roleName}}, {{company}} · {{created}}
        </div>
        <div style="white-space: pre-wrap;">{{body}}</div>
        {{#if mine}}
          <div class="text-end">
            <button type="button" class="btn btn-link btn-sm p-0 text-danger-emphasis" hx-delete="/messages/message/{{ID}}" hx-target="closest .card" hx-swap="delete"
                    hx-confirm="Delete your message?" aria-label="Delete your message of {{created}}">Delete</button>
          </div>
        {{/if}}
      </div>
    </div>
  {{/each}}
  {{#unless messages.length}}<p class="text-muted text-center my-3">No message yet. Write the first one below.</p>{{/unless}}
</div>
