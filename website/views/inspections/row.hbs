<tr class="align-middle">
  <td class="text-nowrap">
    <a class="btn btn-sm btn-outline-primary" href="/messages/delivery/{{ID}}" hx-boost="true" hx-target="#main" title="Messages about delivery #{{ID}}" aria-label="Messages about delivery #{{ID}}"><i aria-hidden="true" class="bi bi-chat-dots"></i></a>
    {{#if canInspect}}
      <button type="button" class="btn btn-sm btn-success"
            hx-get="/inspections/{{ID}}/new" hx-target="closest tr" hx-swap="outerHTML" title="Inspect delivery #{{ID}}" aria-label="Inspect delivery #{{ID}}">
        <i aria-hidden="true" class="bi bi-clipboard-check"></i>
      </button>
    {{/if}}
    {{#if canChange}}
      <button type="button" class="btn btn-sm btn-danger"
            hx-delete="/inspections/{{ID}}" hx-target="closest tr" hx-swap="outerHTML"
            hx-confirm="Delete the inspection of delivery #{{ID}}?" title="Delete the inspection of delivery #{{ID}}" aria-label="Delete the inspection of delivery #{{ID}}">
        <i aria-hidden="true" class="bi bi-trash3-fill"></i>
      </button>
      <button type="button" class="btn btn-sm btn-primary"
            hx-get="/inspections/{{ID}}/edit" hx-target="closest tr" hx-swap="outerHTML" title="Edit the inspection of delivery #{{ID}}" aria-label="Edit the inspection of delivery #{{ID}}">
        <i aria-hidden="true" class="bi bi-pencil"></i>
      </button>
    {{/if}}
    {{ID}}
  </td>
  <td>{{project}}</td>
  <td>{{supplier}}</td>
  <td class="text-truncate" style="max-width: 220px;" title="{{material}}">{{material}}</td>
  <td class="small">
    {{#each documents}}
      <div class="text-nowrap"><i aria-hidden="true" class="bi bi-file-earmark-text"></i> {{#if hasFile}}<a href="/files/document/{{ID}}" target="_blank" rel="noopener" hx-boost="false">{{label}}</a>{{else}}{{label}}{{/if}}</div>
    {{else}}
      <span class="text-danger"><i aria-hidden="true" class="bi bi-exclamation-triangle"></i> No documents</span>
    {{/each}}
  </td>
  <td class="text-end text-nowrap">{{ordered}} {{unit}}</td>
  <td>
    {{#if decision}}
      {{decision}}<br><small class="text-muted">received {{received}}, accepted {{accepted}}</small>
    {{else}}
      <span class="text-muted">Waiting</span>
    {{/if}}
  </td>
  <td class="text-end">{{#if decision}}{{acceptedValue}} / {{retention}}{{/if}}</td>
  <td><span class="badge text-bg-{{badge}}">{{status}}</span></td>
</tr>
