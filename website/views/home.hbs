<div class="text-center my-5">
  <i class="bi bi-truck" style="font-size: 20vh;"></i>
  {{#if user}}
    <h2>Welcome, {{user.name}}</h2>
    {{#if isContractor}}
      <p>Use <strong>My deliveries</strong> in the menu to create and manage your delivery records,
         and <strong>Complete and rate</strong> to close the inspected deliveries.</p>
    {{else if isInspector}}
      <p>Use <strong>Inspections</strong> in the menu to inspect the deliveries that have arrived on site.</p>
    {{else if isSupplier}}
      <p>Use <strong>Quality documents</strong> in the menu to add the delivery notes and test reports of your deliveries.</p>
    {{else}}
      <p>The pages for your role are not ready yet.</p>
    {{/if}}
  {{else}}
    <h2>Material Delivery Closed-Loop</h2>
    <p>Please <a href="/login" hx-boost="true" hx-target="#main">sign in</a> to continue.</p>
  {{/if}}
</div>
