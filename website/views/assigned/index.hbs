<h2>Assigned deliveries</h2>
<p class="text-muted">Deliveries that contractors ordered from your company. Move each one forward when you start preparing it,
  when the truck leaves and when it arrives on site. After that the site inspector takes over.</p>
<table class="table table-striped table-hover table-sm">
  <thead>
    <tr>
      <th>ID</th><th>Contractor / project</th><th>Material</th><th class="text-end">Quantity</th>
      <th>Time slot</th><th>Documents</th><th>Status</th><th>Next step</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      {{> assigned/row}}
    {{/each}}
  </tbody>
</table>
{{#unless rows.length}}
  <p class="text-muted text-center">No deliveries have been assigned to your company yet.</p>
{{/unless}}
