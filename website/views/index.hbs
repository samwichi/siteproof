<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <script src="/htmx.min.js"></script>
  <script src="/a11y.js" defer></script>

  <link rel="stylesheet" href="/bootstrap.min.css">
  <link rel="stylesheet" href="/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/site.css">
  <script src="/bootstrap.bundle.min.js"></script>
</head>
<body class="container" hx-indicator:inherited="#loading">
  {{!-- A thin bar at the top of the window, visible while HTMX waits for the server (class htmx-request). --}}
  <div id="loading" class="htmx-indicator position-fixed top-0 start-0 w-100" style="z-index: 2200;" aria-hidden="true">
    <div class="progress" style="height: 4px;"><div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div></div>
  </div>
  {{!-- Keyboard users: the first Tab shows this link, Enter jumps over the menu. --}}
  <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" style="z-index: 2300;" href="#main">Skip to the main content</a>
  <header class="text-center my-3">
    {{!-- The logo already contains the name and the tagline, so it replaces the title text. --}}
    <a href="/" hx-boost="true" hx-target="#main">
      <img src="/images/siteproof-logo.png" alt="SiteProof - Material Delivery &amp; Supplier Management" class="img-fluid" style="max-height: 90px;">
    </a>
  </header>
  {{> navbar}}
  {{!-- Messages stay visible in the corner of the window, also when the user scrolled down to a row. --}}
  <div id="toast" class="position-fixed top-0 end-0 p-3" style="z-index: 2100; width: min(28rem, 100%);" aria-live="polite"></div>
  <main id="main" tabindex="-1" {{#where}} hx-trigger="load" hx-get="{{.}}" {{/where}} hx-history-elt>
    {{> home}}
  </main>
  <footer class="text-center text-muted my-4">
    <p>&copy; 2026 SiteProof - NTUST CT5805701</p>
  </footer>
</body>
</html>
