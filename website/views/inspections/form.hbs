{{!-- The same form is used to create (hx-post) and to change (hx-put) an inspection. It replaces the whole table row. --}}
<tr class="table-warning">
  <td colspan="9">
    <form class="row g-2 align-items-end"
          {{#if isNew}}hx-post="/inspections/{{ID}}"{{else}}hx-put="/inspections/{{ID}}"{{/if}}
          hx-target="closest tr" hx-swap="outerHTML" hx-disable="findAll button">
      <div class="col-12">
        <strong>Delivery #{{ID}}</strong> - {{material}} ({{supplier}}, {{project}}). Ordered: {{ordered}} {{unit}}
      </div>
      <div class="col-12 small">
        Quality documents:
        {{#each documents}}
          <span class="badge text-bg-light border"><i class="bi bi-file-earmark-text"></i> {{this}}</span>
        {{else}}
          <span class="text-danger">the supplier has not added any document yet.</span>
        {{/each}}
      </div>
      <div class="col-md-3">
        <label class="form-label">Received quantity ({{unit}})</label>
        <input class="form-control" type="number" name="received_quantity" value="{{received}}" min="0" step="0.01" required>
      </div>
      <div class="col-md-3">
        <label class="form-label">Accepted quantity ({{unit}})</label>
        <input class="form-control" type="number" name="accepted_quantity" value="{{accepted}}" min="0" step="0.01" required>
      </div>
      <div class="col-md-4 small text-muted">
        Accepted = all received. Partially accepted = less than received. Rejected = 0.
      </div>
      <div class="col-md-2 text-nowrap">
        <button type="submit" class="btn btn-success" title="Save" name="action" value="save">
          <i class="bi bi-check-lg"></i>
        </button>
        <button type="submit" class="btn btn-warning" title="Cancel" name="action" value="cancel" formnovalidate>
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    </form>
  </td>
</tr>
