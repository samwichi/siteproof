{{!-- The form to decline a delivery replaces the table row (the form is inside one wide cell). --}}
<tr class="table-warning">
  <td colspan="8">
    <form class="row g-2 align-items-end" hx-put="/assigned/{{ID}}/decline" hx-target="closest tr" hx-swap="outerHTML" hx-disable="findAll button">
      <div class="col-12"><strong>Decline delivery #{{ID}}</strong> - {{material}}, {{quantity}} {{unit}} for {{contractor}} ({{slotStart}} - {{slotEnd}})</div>
      <div class="col-md-9">
        <label class="form-label" for="reason-{{ID}}">Why can you not deliver it as asked? (the contractor sees it)</label>
        <input class="form-control" id="reason-{{ID}}" name="reason" maxlength="200" autofocus required placeholder="For example: we can deliver on Thursday, not on Tuesday">
      </div>
      <div class="col-md-3 text-nowrap">
        <button type="submit" class="btn btn-danger" name="action" value="decline"><i aria-hidden="true" class="bi bi-x-circle"></i> Decline</button>
        <button type="submit" class="btn btn-secondary" name="action" value="cancel" formnovalidate>Cancel</button>
      </div>
    </form>
  </td>
</tr>
