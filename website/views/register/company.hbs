<h1 class="h2 mb-3">Register a company</h1>
<p class="text-muted">The company account is the account of the person who manages the company on SiteProof. The administrator checks the company before it can be used.</p>
{{!-- multipart: the proof documents are files. Errors come back as a message in the corner and the form keeps what was typed. --}}
<form class="row g-3" hx-post="/register/company" hx-encoding="multipart/form-data" hx-target="#main" hx-disable="findAll button">
  <fieldset class="col-12">
    <legend class="form-label fs-6">Type of company</legend>
    {{#each types}}
      <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="org_type" id="type-{{value}}" value="{{value}}" required>
        <label class="form-check-label" for="type-{{value}}">{{label}}</label>
      </div>
    {{/each}}
  </fieldset>
  <div class="col-md-4">
    <label class="form-label" for="org_id">Company ID (8 digits)</label>
    <input class="form-control" id="org_id" name="org_id" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" required autofocus>
  </div>
  <div class="col-md-8">
    <label class="form-label" for="org_name">Company name</label>
    <input class="form-control" id="org_name" name="org_name" maxlength="100" required>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="address">Address <span class="text-muted">(optional)</span></label>
    <input class="form-control" id="address" name="address" maxlength="200">
  </div>
  <div class="col-md-3">
    <label class="form-label" for="phone">Phone <span class="text-muted">(optional)</span></label>
    <input class="form-control" id="phone" name="phone" maxlength="30" type="tel">
  </div>
  <div class="col-md-3">
    <label class="form-label" for="org_email">Company e-mail <span class="text-muted">(optional)</span></label>
    <input class="form-control" id="org_email" name="org_email" maxlength="100" type="email">
  </div>
  <div class="col-12">
    <label class="form-label" for="proof">Proof documents <span class="text-muted">(optional, up to {{maxFiles}} files)</span></label>
    <input class="form-control" id="proof" name="proof" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="proof-help">
    <div id="proof-help" class="form-text">For example the business registration or the contractor licence. PDF, JPG or PNG, at most 5 MB each. Only the administrator can open them.</div>
  </div>
  <h2 class="h5 mt-4">Company account</h2>
  <div class="col-md-6">
    <label class="form-label" for="full_name">Your name</label>
    <input class="form-control" id="full_name" name="full_name" maxlength="100" autocomplete="name" required>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="email">E-mail (to sign in)</label>
    <input class="form-control" id="email" name="email" type="email" maxlength="100" autocomplete="email" required>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="password">Password</label>
    <input class="form-control" id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" aria-describedby="password-help" required>
    <div id="password-help" class="form-text">At least 8 characters.</div>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="password2">Password again</label>
    <input class="form-control" id="password2" name="password2" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
  </div>
  <div class="col-12">
    <button class="btn btn-success"><i aria-hidden="true" class="bi bi-send-fill"></i> Send the registration</button>
    <a class="btn btn-secondary" href="/register" hx-boost="true" hx-target="#main">Cancel</a>
  </div>
</form>
