{{!-- Both buttons send the status that the user sees ("from"), so the route can refuse a change made on an old screen. --}}
<tr class="align-middle">
  <td>{{ID}}</td>
  <td>{{project}}</td>
  <td>{{contractor}}</td>
  <td class="text-truncate" style="max-width: 260px;" title="{{material}}">{{material}}</td>
  <td class="text-end text-nowrap">{{quantity}} {{unit}}</td>
  <td class="text-nowrap">{{slotStart}} - {{slotEnd}}</td>
  <td class="text-center">{{documents}}</td>
  <td><span class="badge text-bg-{{badge}}">{{status}}</span></td>
  <td class="text-nowrap">
    {{#if next}}
      <button class="btn btn-sm btn-success" title="Change the status to {{next}}"
              hx-put="/status/{{ID}}" hx-vals='{"action": "next", "from": "{{status}}"}'
              hx-target="closest tr" hx-swap="outerHTML"
              hx-confirm="Change delivery #{{ID}} to {{next}}?">
        <i class="bi bi-arrow-right-circle"></i> {{next}}
      </button>
    {{/if}}
    {{#if back}}
      <button class="btn btn-sm btn-outline-secondary" title="Go back to {{back}}"
              hx-put="/status/{{ID}}" hx-vals='{"action": "back", "from": "{{status}}"}'
              hx-target="closest tr" hx-swap="outerHTML"
              hx-confirm="Move delivery #{{ID}} back to {{back}}?">
        <i class="bi bi-arrow-counterclockwise"></i>
      </button>
    {{/if}}
    {{#unless next}}{{#unless back}}<span class="text-muted small">Closed</span>{{/unless}}{{/unless}}
  </td>
</tr>
