<h1 class="h2">Users of {{user.orgName}}</h1>
<p class="text-muted">These people registered for your company. A new registration <strong>waits for your approval</strong>: check that the person really works for {{user.orgName}} before you approve it (only then the person can sign in). Switch an account off when somebody leaves the company: the person cannot sign in any more, and the data of the company stays.</p>
{{> list/controls placeholder="Search by name or e-mail"}}
<div id="list" data-count="{{list.total}}">
  <div class="table-responsive">
    <table class="table table-striped table-hover table-sm">
      <caption class="visually-hidden">Users of the company</caption>
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
          {{> list/th key="name" label="Name"}}
          {{> list/th key="email" label="E-mail"}}
          {{> list/th key="role" label="Role"}}
          {{> list/th key="status" label="Status"}}
          {{> list/th key="registered" label="Registered"}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          {{> company/row}}
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#unless rows.length}}
    <p class="text-muted text-center">{{#if list.filtered}}No user matches your search.{{else}}Nobody registered for your company yet. Tell your colleagues to choose "Register as a user" and to select {{user.orgName}}.{{/if}}</p>
  {{/unless}}
  {{> list/pager}}
</div>
