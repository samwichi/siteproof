<h2>Assigned deliveries</h2>
<p class="text-muted">Deliveries that contractors ordered from your company. Move each one forward when you start preparing it,
  when the truck leaves and when it arrives on site. After that the site inspector takes over.</p>
{{> list/controls placeholder="Search by ID, contractor, project or material"}}
<div id="list">
  <div class="table-responsive">
    <table class="table table-striped table-hover table-sm">
      <thead>
        <tr>
          {{> list/th key="ID" label="ID"}}
          {{> list/th key="contractor" label="Contractor / project"}}
          {{> list/th key="material" label="Material"}}
          {{> list/th key="quantity" label="Quantity" cls="text-end"}}
          {{> list/th key="slot" label="Time slot"}}
          {{> list/th key="documents" label="Documents"}}
          {{> list/th key="status" label="Status"}}
          <th>Next step</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          {{> assigned/row}}
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#unless rows.length}}
    <p class="text-muted text-center">{{#if list.filtered}}No delivery matches your search.{{else}}No deliveries have been assigned to your company yet.{{/if}}</p>
  {{/unless}}
  {{> list/pager}}
</div>
