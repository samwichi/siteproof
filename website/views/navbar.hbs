<nav aria-label="Main menu" class="navbar navbar-expand-lg bg-body-tertiary" hx-boost:inherited="true" hx-target:inherited="#main">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"><i aria-hidden="true" class="bi bi-house-door-fill"></i> Home</a>
    {{#if user}}
    {{!-- On a phone the menu is folded, so the messages and the bell are shown next to its button (without the automatic refresh). --}}
    <div class="d-flex d-lg-none align-items-center ms-auto me-2">
      {{#if user.canMessage}}<a class="nav-link px-2" href="/messages" title="Messages"><i aria-hidden="true" class="bi bi-chat-dots fs-5"></i><span class="visually-hidden">Messages</span></a>{{/if}}
      <a class="nav-link px-2 position-relative" href="/notifications" title="Notifications"><i aria-hidden="true" class="bi bi-bell fs-5"></i><span class="visually-hidden">Notifications</span>{{#if unread}}<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">{{unread}}<span class="visually-hidden"> new notifications</span></span>{{/if}}</a>
    </div>
    {{/if}}
    <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle the menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        {{#if isContractor}}
        {{!-- Home is the shop of the contractor (routes/shop.js); the product table (/catalog) is linked from the shop. --}}
        <li class="nav-item">
          <a class="nav-link" href="/rfqs"><i aria-hidden="true" class="bi bi-envelope-paper"></i> RFQs</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/deliveries"><i aria-hidden="true" class="bi bi-box-seam"></i> My deliveries</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/ratings"><i aria-hidden="true" class="bi bi-star"></i> Complete and rate</a>
        </li>
        {{/if}}
        {{#if isCompany}}
        <li class="nav-item">
          <a class="nav-link" href="/company/orders"><i aria-hidden="true" class="bi bi-speedometer2"></i> Company overview</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/company"><i aria-hidden="true" class="bi bi-people"></i> Users of my company {{> company/waitingBadge}}</a>
        </li>
        {{#if isContractorCompany}}
        <li class="nav-item">
          <a class="nav-link" href="/projects"><i aria-hidden="true" class="bi bi-buildings"></i> Projects</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/company/appointments"><i aria-hidden="true" class="bi bi-clipboard2-check"></i> Inspection companies</a>
        </li>
        {{/if}}
        {{#if isInspectionCompany}}
        <li class="nav-item">
          <a class="nav-link" href="/company/appointments"><i aria-hidden="true" class="bi bi-building"></i> Contractors that appointed us</a>
        </li>
        {{/if}}
        {{/if}}
        {{#if isAdmin}}
        <li class="nav-item">
          <a class="nav-link" href="/admin"><i aria-hidden="true" class="bi bi-buildings"></i> Companies</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/users"><i aria-hidden="true" class="bi bi-people"></i> All users</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/products"><i aria-hidden="true" class="bi bi-box-seam"></i> All products</a>
        </li>
        {{/if}}
        {{#if isInspector}}
        <li class="nav-item">
          <a class="nav-link" href="/inspections"><i aria-hidden="true" class="bi bi-clipboard-check"></i> Inspections</a>
        </li>
        {{/if}}
        {{#if isSupplier}}
        {{!-- Home is the seller center of the supplier (routes/seller.js). --}}
        <li class="nav-item">
          <a class="nav-link" href="/seller/storefront"><i aria-hidden="true" class="bi bi-shop"></i> My storefront</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/quotations"><i aria-hidden="true" class="bi bi-envelope-paper"></i> RFQs {{> quotations/openBadge}}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/products"><i aria-hidden="true" class="bi bi-boxes"></i> My products</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/assigned"><i aria-hidden="true" class="bi bi-truck"></i> Assigned deliveries</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/documents"><i aria-hidden="true" class="bi bi-file-earmark-text"></i> Quality documents</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/history"><i aria-hidden="true" class="bi bi-star-half"></i> My rating and history</a>
        </li>
        {{/if}}
      </ul>
      <div class="d-flex align-items-center">
        {{#if user}}
          {{#if user.canMessage}}
          <a class="nav-link me-2 d-none d-lg-block" href="/messages" title="Messages"><i aria-hidden="true" class="bi bi-chat-dots fs-5"></i><span class="visually-hidden">Messages</span></a>
          {{/if}}
          <a class="nav-link me-3 position-relative d-none d-lg-block" href="/notifications" title="Notifications">
            <i aria-hidden="true" class="bi bi-bell fs-5"></i><span class="visually-hidden">Notifications</span>{{> notifications/badge}}
          </a>
          <a class="nav-link me-3" href="/account" title="My account and password"><i aria-hidden="true" class="bi bi-person-circle"></i> {{user.name}} ({{user.roleName}}{{#if user.orgName}}, {{user.orgName}}{{/if}})</a>
          {{!-- The logout form must reload the whole page, so it is not boosted. --}}
          <form action="/logout" method="post" hx-boost="false">
            <button class="btn btn-outline-dark btn-sm"><i aria-hidden="true" class="bi bi-box-arrow-right"></i> Sign out</button>
          </form>
        {{else}}
          <a class="btn btn-outline-dark btn-sm me-2" href="/register"><i aria-hidden="true" class="bi bi-person-plus"></i> Register</a>
          <a class="btn btn-primary btn-sm" href="/login"><i aria-hidden="true" class="bi bi-box-arrow-in-right"></i> Sign in</a>
        {{/if}}
      </div>
    </div>
  </div>
</nav>
{{#if mustChange}}
  <div class="alert alert-warning py-2 mt-2"><i aria-hidden="true" class="bi bi-key"></i> You signed in with a temporary password.
    <a href="/account" hx-boost="true" hx-target="#main">Change it now</a>.</div>
{{/if}}
