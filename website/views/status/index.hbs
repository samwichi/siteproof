<h2>Assigned deliveries</h2>
<p class="text-muted">Deliveries assigned to your company. Move each one forward as the work progresses:
  SCHEDULED &rarr; PREPARING &rarr; IN_TRANSIT &rarr; DELIVERED. You can go back one step to correct a mistake
  until the delivery is inspected.</p>
<table class="table table-striped table-hover table-sm">
  <thead>
    <tr>
      <th>ID</th><th>Project</th><th>Contractor</th><th>Material</th>
      <th class="text-end">Quantity</th><th>Time slot</th><th class="text-center">Documents</th>
      <th>Status</th><th>Update</th>
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
      {{> status/row}}
    {{/each}}
  </tbody>
</table>
{{#unless rows.length}}
  <p class="text-muted text-center">No deliveries assigned to your company yet.</p>
{{/unless}}
