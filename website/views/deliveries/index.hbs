<h1 class="h2">My deliveries</h1>
<p class="text-muted">Click the ID of a delivery to see its documents, inspection, retention and rating.</p>
<p>
  <a class="btn btn-success" href="/deliveries/new" hx-boost="true" hx-target="#main">
    <i aria-hidden="true" class="bi bi-plus-circle-fill"></i> New delivery
  </a>
</p>
{{> list/controls placeholder="Search by ID, project, supplier or material"}}
<div id="list" data-count="{{list.total}}">
  <div class="table-responsive">
    <table class="table table-striped table-hover table-sm">
      <caption class="visually-hidden">My deliveries</caption>
      <thead>
        <tr>
          {{> list/th key="ID" label="ID"}}
          {{> list/th key="project" label="Project"}}
          {{> list/th key="supplier" label="Supplier"}}
          {{> list/th key="material" label="Material"}}
          {{> list/th key="quantity" label="Quantity" cls="text-end"}}
          {{> list/th key="value" label="Value (NT$)" cls="text-end"}}
          {{> list/th key="slot" label="Time slot"}}
          {{> list/th key="status" label="Status"}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          {{> deliveries/row}}
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#unless rows.length}}
    <p class="text-muted text-center">{{#if list.filtered}}No delivery matches your search.{{else}}No deliveries yet.{{/if}}</p>
  {{/unless}}
  {{> list/pager}}
</div>
{{#if message}}{{> toast}}{{/if}}
