<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <script src="/htmx.min.js"></script>

  <link rel="stylesheet" href="/bootstrap.min.css">
  <link rel="stylesheet" href="/bootstrap-icons.min.css">
  <script src="/bootstrap.bundle.min.js"></script>
</head>
<body class="container">
  <header class="text-center my-3">
    {{!-- The logo already contains the name and the tagline, so it replaces the title text. --}}
    <a href="/" hx-boost="true" hx-target="#main">
      <img src="/images/siteproof-logo.png" alt="SiteProof - Material Delivery &amp; Supplier Management" class="img-fluid" style="max-height: 90px;">
    </a>
  </header>
  {{> navbar}}
  <div id="toast"></div>
  <main id="main" {{#where}} hx-trigger="load" hx-get="{{.}}" {{/where}} hx-history-elt>
    {{> home}}
  </main>
  <footer class="text-center text-muted my-4">
    <p>&copy; 2026 SiteProof - NTUST CT5805701</p>
  </footer>
</body>
</html>
