<tr class="align-middle{{#unless isListed}} table-secondary{{/unless}}">
  <td class="text-nowrap">
    <button type="button" class="btn btn-sm btn-danger"
          hx-delete="/products/{{ID}}" hx-target="closest tr" hx-swap="delete"
          hx-confirm="Delete {{material}} from your products?" title="Delete {{material}}" aria-label="Delete the product {{material}}">
      <i aria-hidden="true" class="bi bi-trash3-fill"></i>
    </button>
    <button type="button" class="btn btn-sm btn-primary"
          hx-get="/products/{{ID}}/edit" hx-target="closest tr" hx-swap="outerHTML" title="Edit {{material}}" aria-label="Edit the product {{material}}">
      <i aria-hidden="true" class="bi bi-pencil"></i>
    </button>
    {{#if isListed}}
      <button type="button" class="btn btn-sm btn-outline-secondary"
            hx-put="/products/{{ID}}/active" hx-vals='{"active": "0"}' hx-target="closest tr" hx-swap="outerHTML"
            title="Unlist {{material}} (the contractors do not see it)" aria-label="Unlist the product {{material}}">
        <i aria-hidden="true" class="bi bi-eye-slash"></i>
      </button>
    {{else}}
      <button type="button" class="btn btn-sm btn-outline-success"
            hx-put="/products/{{ID}}/active" hx-vals='{"active": "1"}' hx-target="closest tr" hx-swap="outerHTML"
            title="List {{material}} again" aria-label="List the product {{material}} again">
        <i aria-hidden="true" class="bi bi-eye"></i>
      </button>
    {{/if}}
  </td>
  <td class="text-truncate" style="max-width: 320px;" title="{{material}}">
    {{material}}
    {{#if note}}<div class="small text-muted text-truncate">{{note}}</div>{{/if}}
  </td>
  <td>{{category}}</td>
  <td class="text-end text-nowrap">{{#if samePrice}}{{priceMin}}{{else}}{{priceMin}} - {{priceMax}}{{/if}} / {{unit}}</td>
  <td class="text-end text-nowrap">{{#if minOrder}}{{minOrder}} {{unit}}{{else}}<span class="text-muted">-</span>{{/if}}</td>
  <td class="text-end text-nowrap">{{#if leadTime}}{{leadTime}} days{{else}}<span class="text-muted">-</span>{{/if}}</td>
  <td class="text-end">{{deliveries}}</td>
  <td>{{#if isListed}}<span class="badge text-bg-success">Listed</span>{{else}}<span class="badge text-bg-secondary">Unlisted</span>{{/if}}</td>
</tr>
